# ---- HKAT Generator 配置 / configuration ----
# 複製這個檔案為 .env，然後填上你的資料。
# Copy this file to .env and fill in your own values.

# 服務器端口 / server port
PORT=3000

# ---- AI 設定 / AI settings (OpenAI-compatible API) ----
# 任何 OpenAI 相容的 API 都可以用：OpenAI、DeepSeek、Groq、OpenRouter、
# 香港的服務供應商、或本地 Ollama / LM Studio (http://localhost:11434/v1)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- 進階 / advanced ----
# 賉料庫位置（預設為 ./data/app.db）/ database location
# DB_PATH=./data/app.db

# 模擬 AI（不用 API key 也能試用介面）/ mock AI for trying the UI without a key
# MOCK_AI=1
